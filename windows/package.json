{
  "name": "bandwave",
  "version": "0.1.0",
  "description": "Live music visualizer for the Windows desktop wallpaper",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "helper": "pyinstaller --noconfirm --onedir --console --name bandwave-helper --distpath build/helper-dist --workpath build/pyi --specpath build --paths helper --hidden-import spotify_ui --hidden-import loopback --collect-all uiautomation --collect-all winrt --collect-all pyaudiowpatch helper/media.py",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Bandwave",
  "build": {
    "appId": "app.bandwave.visualizer",
    "productName": "Bandwave",
    "files": [
      "main.js",
      "preload.js",
      "defaults.js",
      "viz.html",
      "viz.js",
      "settings.html",
      "settings.js",
      "browse.html",
      "browse.js",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/helper-dist/bandwave-helper",
        "to": "helper"
      },
      "spotify-watch.ps1",
      "spotify-watch.vbs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bandwave",
      "artifactName": "Bandwave-Setup.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
